{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warn_missing_spec,
    warnings_as_errors
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_hank,
    rebar3_hex
]}.

{hex, [
    {doc, ex_doc},
    {build_tools, ["rebar3"]},
    {files, [
        "src",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ]}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/nomasystems/nyaml">>},
    {homepage_url, <<"https://github.com/nomasystems/nyaml">>},
    {extras, [
        {<<"README.md">>, #{title => <<"Overview">>}},
        {<<"CHANGELOG.md">>, #{title => <<"Changelog">>}},
        {<<"LICENSE">>, #{title => <<"License">>}}
    ]},
    {main, <<"README.md">>},
    {api_reference, true},
    {groups_for_modules, [
        {<<"Public API">>, [nyaml]},
        {<<"Internal">>, [
            nyaml_block,
            nyaml_block_mapping,
            nyaml_block_scalar,
            nyaml_block_util,
            nyaml_complex_scalar,
            nyaml_emit,
            nyaml_emit_scalar,
            nyaml_encoding,
            nyaml_flow,
            nyaml_merge,
            nyaml_parser,
            nyaml_parser_util,
            nyaml_scalar
        ]}
    ]}
]}.

{erlfmt, [write]}.

{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]},
        {erl_opts, [nowarn_missing_spec]}
    ]}
]}.

{alias, [
    {check, [
        compile,
        {fmt, "--check"},
        xref,
        dialyzer,
        hank
    ]},
    {test, [
        {eunit, "--cover"},
        {ct, "--cover --readable=true"},
        cover
    ]},
    {compliance, [
        {ct, "--suite=yaml_compliance_SUITE --readable=true"}
    ]}
]}.

{ct_opts, [
    {dir, "test"},
    {logdir, "_build/test/logs"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown,
        extra_return,
        missing_return
    ]}
]}.

{cover_opts, [verbose, {min_coverage, 85}]}.
{cover_enabled, true}.

{hank, [
    {ignore, [
        %% CT callbacks require specific signatures
        "test/**"
    ]}
]}.
